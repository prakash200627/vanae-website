# Local / deployment environment template for VANAE.
# Copy to `.env` or `.env.local` and fill in real values. Never commit secrets.
# Variable names below are taken from current source usage only.

# MongoDB connection string used by `src/lib/mongodb.ts` (enquiries + admin data).
MONGODB_URI=

# Admin sign-in identifier — provide ONE of these (see `src/lib/adminCredentials.ts`).
# Email is preferred when both are present; either may identify the admin account.
ADMIN_EMAIL=
# ADMIN_USERNAME=

# Scrypt password hash for the admin account (`src/lib/adminCredentials.ts`).
# Generate with `node scripts/generate-admin-hash.mjs` — do not store a plaintext password here.
ADMIN_PASSWORD_HASH=

# HMAC secret for signed admin session cookies (`src/lib/auth.ts`).
# Must be a high-entropy string at least as long as the code’s minimum length check.
ADMIN_SESSION_SECRET=

# Note: `NODE_ENV` is set by Next.js / the host runtime — do not set it here for local apps.
# Note: plaintext `ADMIN_PASSWORD` is not used by the application auth path.
