# VANAE Environment Configuration Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# MongoDB Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Admin Authentication
# Email / identifier used to sign in to /admin/login
ADMIN_EMAIL=

# Admin Password
ADMIN_PASSWORD=

# HMAC-SHA256 session cookie signing secret (minimum 32 characters, high entropy)
# Generate using: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Optional: Production Public Domain (canonical URLs, Open Graph, Sitemap, Robots)
# Defaults to https://vanae-website.vercel.app if omitted
# Example: https://vanae.com
# NEXT_PUBLIC_SITE_URL=
